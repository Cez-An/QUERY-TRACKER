<div class="row g-3">
  <div class="col-md-6">
    <label for="authorName"><strong>Author Name:</strong> </label>
    <input type="text" class="form-control" name="authorName" placeholder="Author Name" required>
  </div>
  <div class="col-md-6">
    <label for="sbNumber"><strong>SB Number:</strong> </label>
    <input type="text" class="form-control" name="sbNumber" placeholder="SB Number" required>
  </div>
  <div class="col-md-6">
    <label for="model"><strong>Model:</strong> </label>
    <input type="text" class="form-control" name="model" placeholder="Model" required>
  </div>
  <div class="col-md-6">
    <label for="revision"><strong>Revision:</strong> </label>
    <input type="text" class="form-control" name="revision" placeholder="Revision">
  </div>
  <div class="col-md-6">
    <label for="status"><strong>Status:</strong> </label>
    <select class="form-control" name="status">
      <option value="Open" selected>Open</option>
      <option value="Closed">Closed</option>
    </select>
  </div>
  <div class="col-md-6">
    <label for="resolverName"><strong>Resolver Name:</strong> </label>
    <input type="text" class="form-control" name="resolverName" placeholder="Resolver Name">
  </div>
  <div class="col-md-12">
    <label for="comment"><strong>Comment:</strong> </label>
    <textarea class="form-control" name="comment" placeholder="Write here..."></textarea>
  </div>
  
  <div class="col-12 text-end">

    <button type="submit" class="btn btn-primary">Save Query</button>
  </div>
</div>
