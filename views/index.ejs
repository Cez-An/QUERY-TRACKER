    <!-- ✅ Modal PDF Viewer -->
    <div id="pdfViewerContainer" class="modal" aria-label="PDF Viewer">
      <div class="modal-content">
        <button id="closePdfBtn" class="btn btn-icon close-btn" title="Close PDF Viewer">
          close <i class="bi bi-x-lg text-danger "></i>
